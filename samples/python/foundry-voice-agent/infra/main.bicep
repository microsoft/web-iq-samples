targetScope = 'resourceGroup'

@description('Azure region for the App Service plan and web app.')
param location string = resourceGroup().location

@description('Globally unique web app name. The app URL becomes https://<appName>.azurewebsites.net.')
@minLength(2)
@maxLength(60)
param appName string

@description('App Service plan name.')
param planName string = 'asp-${appName}'

@description('Existing Microsoft Foundry resource (account) name that hosts the project.')
param foundryAccountName string

@description('Existing Microsoft Foundry project name.')
param foundryProjectName string

@description('Resource group that contains the Foundry resource. Defaults to this resource group.')
param foundryResourceGroupName string = resourceGroup().name

@description('Native voice agent name created by app.setup_agent.')
param agentName string

@description('Pinned native voice agent version created by app.setup_agent.')
param agentVersion string

@description('Optional IPv4/IPv6 CIDRs allowed to reach the site and deployment endpoint. Empty allows any client; the passphrase gate still applies.')
param allowedIpCidrs array = []

@description('Maximum concurrent conversations (1-10).')
@minValue(1)
@maxValue(10)
param maxConversations int = 10

@secure()
@description('Web IQ API key, stored as an app setting. Never commit this value.')
param webiqApiKey string

@secure()
@description('Passphrase verifier generated by app.setup_access. Never commit this value.')
param authVerifier string

param tags object = {}

module hosting './modules/hosting.bicep' = {
  name: 'foundry-voice-agent-hosting'
  params: {
    location: location
    planName: planName
    appName: appName
    tags: tags
    allowedIpCidrs: allowedIpCidrs
    maxConversations: maxConversations
    projectEndpoint: 'https://${foundryAccountName}.services.ai.azure.com/api/projects/${foundryProjectName}'
    agentName: agentName
    agentVersion: agentVersion
    tenantId: tenant().tenantId
    webiqApiKey: webiqApiKey
    authVerifier: authVerifier
  }
}

module foundryRole './modules/foundry-role.bicep' = {
  name: 'foundry-voice-agent-role'
  scope: resourceGroup(foundryResourceGroupName)
  params: {
    foundryAccountName: foundryAccountName
    foundryProjectName: foundryProjectName
    principalId: hosting.outputs.principalId
    siteId: hosting.outputs.appId
  }
}

output appUrl string = hosting.outputs.appUrl
output appName string = appName
output principalId string = hosting.outputs.principalId
output roleAssignmentId string = foundryRole.outputs.roleAssignmentId
