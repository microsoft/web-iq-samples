# Copy to .env and fill in locally. Never commit .env.
# Web IQ API key (sent to Web IQ MCP in the x-apikey header).
WEBIQ_API_KEY=<your-web-iq-api-key>
WEBIQ_ENDPOINT=https://api.microsoft.ai/v3/mcp

# Microsoft Foundry project endpoint, from the project's Overview page.
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>

# Optional: tenant for Azure CLI sign-in when you have access to multiple tenants.
AZURE_TENANT_ID=

# Optional overrides: set BOTH or neither. By default the app reads .foundry/agent.json.
FOUNDRY_VOICE_AGENT_NAME=
FOUNDRY_VOICE_AGENT_VERSION=

# Optional: disable local timing-only logs with 0. No queries, transcripts, or keys are logged.
PERF_LOG_ENABLED=1

# Local-only background agent checks: 30-second maximum validation age.
# Set 0 for fresh validation on every connection and no background Azure requests.
# Hosted mode always validates per connection.
LOCAL_AGENT_VALIDATION_ENABLED=1
